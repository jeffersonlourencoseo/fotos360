---
const { client } = Astro.props;
const count = client.photos.length;
const thumbWebp = `${client.thumbnail}.webp`;
const thumbJpg = `${client.thumbnail}.jpg`;
---

<article
  class="group relative overflow-hidden rounded-xl border border-white/10 bg-white/[0.03] transition-all duration-300 hover:border-gold/50 hover:bg-white/[0.06] hover:shadow-[0_0_40px_-12px_rgba(197,160,89,0.25)]"
>
  <div class="relative aspect-[4/3] overflow-hidden">
    <picture>
      <source srcset={thumbWebp} type="image/webp" />
      <img
        src={thumbJpg}
        alt={`Foto 360° de ${client.name}`}
        loading="lazy"
        decoding="async"
        width="600"
        height="450"
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
      />
    </picture>
    <div class="absolute inset-0 bg-gradient-to-t from-near-black via-near-black/40 to-transparent"></div>

    <div class="absolute bottom-0 left-0 right-0 p-5">
      <p class="mb-1 text-xs font-semibold uppercase tracking-widest text-gold">
        {client.category}
      </p>
      <h3 class="font-serif text-2xl font-semibold text-cream">
        {client.name}
      </h3>
      <p class="mt-1 text-sm text-cream-muted">
        {count} {count === 1 ? "ambiente" : "ambientes"}
      </p>
    </div>
  </div>

  <div class="p-5 space-y-3">
    {
      client.tourUrl && (
        <a
          href={client.tourUrl}
          target="_blank"
          rel="noopener"
          class="inline-flex w-full items-center justify-center gap-2 rounded-full border border-gold bg-gold px-6 py-3 text-sm font-semibold uppercase tracking-wider text-near-black transition-colors hover:bg-gold-light"
        >
          <span>Tour Virtual</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 2a10 10 0 1 0 10 10 4 4 0 0 1-5-5 4 4 0 0 1-5 5c0 2.2 2.2 4 5 5z" />
            <circle cx="12" cy="12" r="3" />
          </svg>
        </a>
      )
    }
    <button
      type="button"
      data-open-viewer={client.id}
      class="inline-flex w-full items-center justify-center gap-2 rounded-full border border-gold px-6 py-3 text-sm font-semibold uppercase tracking-wider text-gold transition-colors hover:bg-gold hover:text-near-black"
    >
      <span>Fotos 360°</span>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="10"></circle>
        <path d="m16 12-4-4-4 4"></path>
        <path d="M12 16V8"></path>
      </svg>
    </button>
  </div>
</article>
