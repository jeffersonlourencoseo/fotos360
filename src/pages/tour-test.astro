---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Tour 360° Teste | Gentlemens Barber Beer">
  <!-- Carrega Pannellum de forma síncrona nesta página -->
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/pannellum@2.5.6/build/pannellum.css"
    crossorigin="anonymous"
  />
  <script
    src="https://cdn.jsdelivr.net/npm/pannellum@2.5.6/build/pannellum.js"
    crossorigin="anonymous"
    is:inline></script>

  <main class="min-h-screen flex flex-col bg-[#0a0a0a]">
    <!-- Header -->
    <header class="px-6 py-5 border-b border-[#2a2a2a]">
      <div class="max-w-6xl mx-auto flex items-center justify-between">
        <div>
          <p class="text-xs uppercase tracking-[0.2em] text-[#c9a227]">Teste de tour virtual</p>
          <h1 class="text-2xl md:text-3xl font-serif font-semibold text-[#f4f1ea]">
            Gentlemens Barber Beer
          </h1>
        </div>
        <a
          href="/"
          class="text-sm px-4 py-2 rounded border border-[#c9a227] text-[#c9a227] hover:bg-[#c9a227] hover:text-[#0a0a0a] transition-colors"
        >
          Voltar ao portfólio
        </a>
      </div>
    </header>

    <!-- Viewer -->
    <div class="px-4 py-6 md:px-8">
      <div class="max-w-5xl mx-auto">
        <div class="relative h-[400px] md:h-[520px] rounded-xl overflow-hidden border border-[#2a2a2a]">
          <div
            id="panorama"
            class="absolute inset-0 w-full h-full bg-red-900/40 flex items-center justify-center text-[#f4f1ea] text-center px-6"
          >
            <div id="start-screen" class="flex flex-col items-center gap-4">
              <p class="text-lg">Clique para iniciar o tour 360°</p>
              <button
                id="start-btn"
                type="button"
                class="px-6 py-3 rounded bg-[#c9a227] text-[#0a0a0a] font-semibold hover:bg-[#e6bc3b] transition-colors"
              >
                Iniciar Tour
              </button>
            </div>
          </div>

          <!-- Overlay hint -->
          <div
            id="tour-hint"
            class="absolute top-4 left-1/2 -translate-x-1/2 z-10 px-4 py-2 rounded-full bg-black/70 text-xs md:text-sm text-[#f4f1ea] backdrop-blur-sm pointer-events-none opacity-0 transition-opacity duration-500"
          >
            Arraste para olhar ao redor. Clique nas setas para andar pelo ambiente.
          </div>
        </div>
      </div>
    </div>

    <!-- Scene thumbnails -->
    <div class="border-t border-[#2a2a2a] bg-[#111]">
      <div class="max-w-6xl mx-auto px-6 py-4">
        <p class="text-xs uppercase tracking-wider text-[#888] mb-3">Navegação rápida</p>
        <div class="flex gap-3 overflow-x-auto pb-2" id="scene-buttons">
          <!-- Botões gerados pelo JS -->
        </div>
      </div>
    </div>

    <!-- Debug panel (escondido no site, visível só no console) -->
    <div class="hidden border-t border-[#2a2a2a] bg-[#0f0f0f] px-6 py-3">
      <div class="max-w-6xl mx-auto">
        <p class="text-xs uppercase tracking-wider text-[#888] mb-2">Diagnóstico</p>
        <pre
          id="debug-output"
          class="text-xs text-[#aaa] font-mono whitespace-pre-wrap break-all max-h-40 overflow-y-auto"
        >Aguardando...</pre>
      </div>
    </div>
  </main>

  <script is:inline>
    const basePath = "/panoramas/gentlemens-barber-beer";
    const debugEl = document.getElementById("debug-output");

    function log(msg) {
      const line = typeof msg === "string" ? msg : JSON.stringify(msg);
      debugEl.textContent += "\n" + line;
      debugEl.scrollTop = debugEl.scrollHeight;
    }

    const scenes = {
      fachada: {
        title: "Fachada",
        type: "equirectangular",
        panorama: `${basePath}/01.jpg`,
        yaw: 0,
        pitch: 0,
        hfov: 100,
        minHfov: 50,
        maxHfov: 120,
        hotSpots: [
          { yaw: 1.7, pitch: 7, type: "scene", text: "→ Lounge", sceneId: "lounge", targetYaw: 182, targetPitch: -9.8 },
        ],
      },
      lounge: {
        title: "Lounge",
        type: "equirectangular",
        panorama: `${basePath}/02.jpg`,
        yaw: 182,
        pitch: -9.8,
        hfov: 100,
        minHfov: 50,
        maxHfov: 120,
        hotSpots: [
          { yaw: 172.6, pitch: -9.8, type: "scene", text: "→ Fachada", sceneId: "fachada", targetYaw: -7, targetPitch: 0 },
          { yaw: -0.1, pitch: -0.5, type: "scene", text: "→ Área de Corte 1", sceneId: "area-de-corte-1", targetYaw: -4.4, targetPitch: -5.2 },
        ],
      },
      "area-de-corte-1": {
        title: "Área de Corte 1",
        type: "equirectangular",
        panorama: `${basePath}/03.jpg`,
        yaw: -4.4,
        pitch: -5.2,
        hfov: 100,
        minHfov: 50,
        maxHfov: 120,
        hotSpots: [
          { yaw: 169.3, pitch: -9.5, type: "scene", text: "→ Lounge", sceneId: "lounge", targetYaw: -0.1, targetPitch: -0.5 },
          { yaw: -4.4, pitch: -5.2, type: "scene", text: "→ Área de Corte 2", sceneId: "area-de-corte-2", targetYaw: -2.1, targetPitch: -5.1 },
        ],
      },
      "area-de-corte-2": {
        title: "Área de Corte 2",
        type: "equirectangular",
        panorama: `${basePath}/04.jpg`,
        yaw: -2.1,
        pitch: -5.1,
        hfov: 100,
        minHfov: 50,
        maxHfov: 120,
        hotSpots: [
          { yaw: -2.1, pitch: -5.1, type: "scene", text: "→ Área de Corte 1", sceneId: "area-de-corte-1", targetYaw: 169.3, targetPitch: -9.5 },
          { yaw: -174, pitch: -5.7, type: "scene", text: "→ Área de Corte 3", sceneId: "area-de-corte-3", targetYaw: 2.4, targetPitch: -5 },
        ],
      },
      "area-de-corte-3": {
        title: "Área de Corte 3",
        type: "equirectangular",
        panorama: `${basePath}/05.jpg`,
        yaw: 2.4,
        pitch: -5,
        hfov: 100,
        minHfov: 50,
        maxHfov: 120,
        hotSpots: [
          { yaw: 2.4, pitch: -5, type: "scene", text: "→ Área de Corte 2", sceneId: "area-de-corte-2", targetYaw: -174, targetPitch: -5.7 },
        ],
      },
    };

    function showHint() {
      const hint = document.getElementById("tour-hint");
      if (hint) hint.classList.remove("opacity-0");
    }

    function initTour() {
      const container = document.getElementById("panorama");
      const startScreen = document.getElementById("start-screen");
      log("Iniciando tour...");

      if (typeof window.pannellum === "undefined") {
        container.textContent = "Erro: visualizador 360° não carregou.";
        log("window.pannellum está undefined");
        return;
      }
      log("Pannellum carregado");

      if (startScreen) startScreen.remove();
      container.classList.remove("flex", "items-center", "justify-center", "text-[#f4f1ea]", "text-center", "px-6");
      container.classList.add("bg-black");
      container.textContent = "";

      let tour;
      try {
        tour = window.pannellum.viewer("panorama", {
          default: {
            firstScene: "fachada",
            sceneFadeDuration: 800,
            autoLoad: true,
            compass: false,
          },
          scenes,
        });
        log("viewer criado");
      } catch (err) {
        container.textContent = "Erro ao criar o tour.";
        log("ERRO: " + err.message);
        console.error(err);
        return;
      }

      const buttonsContainer = document.getElementById("scene-buttons");
      Object.keys(scenes).forEach((sceneId) => {
        const scene = scenes[sceneId];
        const btn = document.createElement("button");
        btn.className =
          "flex-shrink-0 px-4 py-2 rounded bg-[#1f1f1f] text-sm text-[#f4f1ea] border border-[#333] hover:border-[#c9a227] hover:text-[#c9a227] transition-colors whitespace-nowrap";
        btn.textContent = scene.title;
        btn.addEventListener("click", () => {
          log("botão: " + sceneId);
          tour.loadScene(sceneId);
        });
        buttonsContainer.appendChild(btn);
      });

      tour.on("load", () => {
        log("load OK");
        showHint();
      });

      tour.on("error", (err) => {
        log("ERRO tour: " + (err?.message || JSON.stringify(err)));
      });

      tour.on("scenechange", () => {
        log("scenechange");
      });
    }

    document.getElementById("start-btn")?.addEventListener("click", initTour);

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", () => log("DOM pronto"));
    } else {
      log("DOM já pronto");
    }
  </script>
</Layout>
